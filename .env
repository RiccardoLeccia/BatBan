# ===================================================
# CONFIGURAZIONE SERVER & AMBIENTE
# ===================================================
PORT=3000
NODE_ENV=development

# ===================================================
# CONFIGURAZIONE OAUTH 2.0 / OPENID CONNECT (IdP)
# ===================================================
# URL dell'Identity Provider B2B (es. Keycloak, Auth0, Okta o IdP interno)
OAUTH_ISSUER_BASE_URL=https://auth.yourdomain.com/
OAUTH_AUDIENCE=b2b-helpdesk-api

# Segreto per test locali veloci (HS256)
JWT_SECRET=helpdesk_super_secret_key_test_2026_b2b

# CHIAVE PUBBLICA RSA (RS256) per produzione o integrazione reale
# Incolla qui il certificato fornito dal tuo Identity Provider
OAUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAz123456789...PROVA\n-----END PUBLIC KEY-----"

# ===================================================
# CONFIGURAZIONE SWAGGER / DOCUMENTAZIONE API
# ===================================================
SWAGGER_AUTH_URL=https://auth.yourdomain.com/oauth/authorize
SWAGGER_TOKEN_URL=https://auth.yourdomain.com/oauth/token