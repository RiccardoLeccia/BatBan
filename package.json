{
  "name": "b2b-helpdesk-kanban",
  "version": "2.0.0",
  "description": "Helpdesk B2B con Kanban e scadenze SLA",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/index.jsx --bundle --minify --jsx=automatic --drop:console --drop:debugger --legal-comments=none --outfile=public/bundle.js",
    "watch": "esbuild src/index.jsx --bundle --jsx=automatic --sourcemap --outfile=public/bundle.js --watch",
    "seed": "node data/seed.js",
    "start": "npm run build && node server.js"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
